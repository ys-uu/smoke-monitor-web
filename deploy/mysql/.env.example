# =====================================================================
# 环境变量模板：复制为同目录 .env 后按本机情况修改（.env 不提交 git）
#   Copy-Item deploy/mysql/.env.example deploy/mysql/.env
# 默认值为仅绑定 127.0.0.1 的开发环境弱密码，可直接用于本机开发；
# 若在局域网/公网部署，必须更换强密码、收紧路径白名单并增加鉴权。
# =====================================================================

# ===== 专用 MySQL 容器 smoke-mysql =====
# 宿主机映射端口（容器内固定 3306）；若该端口被占用，改为 3308 等空闲端口
SMOKE_MYSQL_HOST_PORT=3307
SMOKE_MYSQL_DATABASE=smoke_detection
SMOKE_MYSQL_USER=smoke
SMOKE_MYSQL_ROOT_PWD=root123456
SMOKE_MYSQL_APP_PWD=smoke123456

# ===== Flask Web 服务 =====
WEB_HOST=127.0.0.1
# 若 8010 被占用，改为其他空闲端口
WEB_PORT=8010
# 连接串主机端口必须与 SMOKE_MYSQL_HOST_PORT 保持一致
SMOKE_DATABASE_URL="mysql+pymysql://smoke:smoke123456@127.0.0.1:3307/smoke_detection?charset=utf8mb4"

# 应急 SQLite（默认不启用；取消注释并注释掉上一行 MySQL 连接串后生效）
# SMOKE_DATABASE_URL="sqlite:///instance/smoke_emergency.db"

# 本机路径直读白名单：* = 允许任意本机绝对路径（仅回环单机使用）；
# 收紧示例（Windows 分号分隔，支持盘符绝对路径与工程根相对路径）：
# SMOKE_LOCAL_PATH_ROOTS=D:/video_data;E:/downloads
SMOKE_LOCAL_PATH_ROOTS=*

# ===== 模型 / 样例（默认使用工程内 models/ 与 samples/，自包含，通常无需配置）=====
# 如需直接引用工程外部的权重 / 视频目录而不复制进本工程，取消注释并改为实际路径（用正斜杠 /）：
# SMOKE_DEFAULT_WEIGHTS=D:/models/smoke_best.pt
# SMOKE_FACE_WEIGHTS=D:/models/yolov8n-face.pt
# SMOKE_FACE_CONF=0.35
# SMOKE_SAMPLE_VIDEO_DIR=D:/video_samples
# 注意：conf/iou/imgsz/投票窗口/冷却等会话参数由页面在“开始会话前”传入、运行中锁定，不走 .env 热更。
